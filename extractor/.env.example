# Apify API Token (znajdziesz go w Apify Console -> Settings -> Integrations -> API Tokens)
APIFY_API_TOKEN=twoj_apify_api_token

# Konfiguracja LLM (OpenRouter, OpenAI lub lokalne LM Studio)
# Domyślnie OpenRouter lub OpenAI:
OPENAI_API_KEY=twoj_klucz_api
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Przykładowe modele:
# - OpenRouter: deepseek/deepseek-chat, deepseek/deepseek-r1, anthropic/claude-3.5-sonnet, openai/gpt-4o-mini
# - OpenAI: gpt-4o, gpt-4o-mini
# - LM Studio (lokalnie): OPENAI_BASE_URL=http://localhost:1234/v1, OPENAI_API_KEY=not-needed
MODEL_NAME=deepseek/deepseek-chat
# Ekstrakcja i podsumowanie. Alias openrouter/space-bunny też jest rozpoznawany.
EXTRACTION_MODEL=stealth/space-bunny-alpha
MAX_LLM_WORKERS=4

# Lokalny CLM System One. Embedder Qwen3-8B jest za clm-serve, nie wołany stąd.
CLM_BASE_URL=http://127.0.0.1:8700
CLM_MODEL=clm-latest
CLM_API_KEY=
# OCR jest osobny: embedder nie widzi obrazów. Puste pola wyłączają OCR i zostawiają alt-text.
LOCAL_OCR_BASE_URL=
LOCAL_OCR_API_KEY=
LOCAL_OCR_MODEL=

# Jev / TypeSafe jako szybki filtr przed DeepSeek
TYPESAFE_API_KEY=twoj_typesafe_api_key
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_VALUABLE_THRESHOLD=0.65
JEV_BATCH_SIZE=25

# Ustawienia scrapowania
TWITTER_HANDLE=kunchenguid
MAX_TWEETS=100
INCLUDE_REPLIES=true
